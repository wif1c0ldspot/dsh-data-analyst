# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
#
# Load in a shell before running dsh / evals / downloads:
#   set -a && source .env && set +a
#
# Prefer ~/.kaggle/access_token for Kaggle when you can; KAGGLE_API_TOKEN
# is the env alternative documented in docs/analyst-setup.md.

# DeepSeek official API key (model chat / live NL evals)
DEEPSEEK_API_KEY=

# Kaggle API access token (Settings → API). Token string only — no username.
# May also be a path to a file that contains the token.
KAGGLE_API_TOKEN=
